# ==============================================================================
# LOKHA Backend - Server Environment Configuration (.env)
# ==============================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / Google Cloud SQL Connection
# Option A: Connection URL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lokha_db?sslmode=disable

# Option B: Standard PG variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=lokha_db
DB_SSL=false
DB_MAX_CONNECTIONS=20
LOG_SQL_QUERIES=false

# Firebase Admin SDK
FIREBASE_PROJECT_ID=lokha-82898
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
