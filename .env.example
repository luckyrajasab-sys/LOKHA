# ==============================================================================
# LOKHA Real Estate Platform - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# (Only variables prefixed with VITE_ are exposed to the browser)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# Backend API Configuration (Server / Cloud Functions)
# (NEVER expose these credentials to the client browser)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL / Cloud SQL Credentials
# Option A: Full Connection String (Recommended for Cloud SQL with SSL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lokha_db?sslmode=disable

# Option B: Individual Connection Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_secure_password
PGDATABASE=lokha_db
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=lokha-82898
# Path to service account private key JSON (optional if running on GCP / Cloud Functions)
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
