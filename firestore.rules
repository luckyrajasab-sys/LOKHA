rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Access Control Architecture
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (matches request.auth.uid)
    // Fields:
    //   - uid: string (matches auth.uid, immutable)
    //   - fullName: string (min 1, max 100)
    //   - email: string (valid email format)
    //   - phone: string (optional)
    //   - profileImage: string (optional URL)
    //   - role: string ('buyer' | 'owner' | 'agent' | 'admin', immutable by non-admin)
    //   - createdAt: string (ISO timestamp)
    //   - updatedAt: string (ISO timestamp)
    //   - isActive: bool
    //
    // Subcollection: users/{uid}/favorites/{propertyId}
    //   - propertyId: string
    //   - createdAt: string
    //
    // Subcollection: users/{uid}/notifications/{notificationId}
    //   - type: string
    //   - title: string
    //   - message: string
    //   - isRead: bool
    //   - createdAt: string
    //
    // Collection: properties
    // Document ID: {propertyId}
    // Fields:
    //   - propertyId: string
    //   - ownerId: string (UID of owner, immutable once set)
    //   - agentId: string (optional UID of assigned agent)
    //   - title: string (min 3, max 200)
    //   - description: string
    //   - propertyType: string ('Apartment' | 'Villa' | 'House' | 'Plot' | 'Commercial' | 'Office' | 'Shop')
    //   - listingType: string ('Sale' | 'Rent' | 'Lease')
    //   - price: number (>= 0)
    //   - status: string ('available' | 'sold' | 'rented' | 'inactive')
    //   - isFeatured: bool
    //   - createdAt: string
    //   - updatedAt: string
    //
    // Collection: inquiries
    // Document ID: {inquiryId}
    // Fields:
    //   - inquiryId: string
    //   - propertyId: string
    //   - buyerId: string (request.auth.uid)
    //   - ownerId: string
    //   - agentId: string (optional)
    //   - message: string
    //   - status: string ('new' | 'contacted' | 'closed')
    //   - createdAt: string
    //
    // Collection: conversations
    // Document ID: {conversationId}
    // Fields:
    //   - participants: list of strings (UIDs)
    //   - propertyId: string
    //   - lastMessage: string
    //   - lastMessageAt: string
    //
    // Subcollection: conversations/{conversationId}/messages/{messageId}
    //   - senderId: string (request.auth.uid)
    //   - receiverId: string
    //   - message: string
    //   - createdAt: string
    //   - read: bool
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Anyone authenticated can read user profile summaries (for chats/listings)
      allow read: if isAuthenticated();

      // Users can only create their own user document
      allow create: if isUser(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['buyer', 'owner', 'agent', 'admin']);

      // Users can update their profile; non-admins CANNOT change their own role or UID
      allow update: if isUser(userId) &&
        request.resource.data.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid']) || isAdmin())
        || isAdmin();

      allow delete: if isAdmin();

      // Favorites Subcollection
      match /favorites/{propertyId} {
        allow read, write: if isUser(userId) || isAdmin();
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isUser(userId) || isAdmin();
        // Allow creating notifications by authenticated users (e.g. when inquiries/messages are sent)
        allow create: if isAuthenticated();
      }
    }

    // PROPERTIES COLLECTION
    match /properties/{propertyId} {
      // Anyone can view available/published properties; owner, agent, and admin can view any status
      allow read: if resource.data.status == 'available' ||
        resource.data.status == 'Published' ||
        (isAuthenticated() && (
          resource.data.ownerId == request.auth.uid ||
          resource.data.agentId == request.auth.uid ||
          isAdmin()
        ));

      // Authenticated owners/agents can create properties matching their own UID
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == request.auth.uid;

      // Only owner, assigned agent, or admin can update property listings
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );

      // Only owner or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // INQUIRIES COLLECTION
    match /inquiries/{inquiryId} {
      // Inquiries can be read by buyer, owner, assigned agent, or admin
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );

      // Authenticated buyers can create inquiries for themselves
      allow create: if isAuthenticated() &&
        request.resource.data.buyerId == request.auth.uid;

      // Owner, assigned agent, or admin can update inquiry status ('contacted', 'closed')
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        resource.data.buyerId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // CONVERSATIONS & REALTIME MESSAGING
    match /conversations/{conversationId} {
      // Only conversation participants or admin can read and update conversations
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants;

      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );

      // Subcollection: messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]) ||
          isAdmin()
        );

        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);

        allow update: if isAuthenticated() && (
          resource.data.receiverId == request.auth.uid ||
          isAdmin()
        );

        allow delete: if isAdmin();
      }
    }

    // LEGACY & EXTENSION COLLECTIONS (accommodations, projects, bookings)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /projectOffers/{offerId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /accommodations/{accommodationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.hostId == request.auth.uid ||
        isAdmin()
      );
    }

    // SITE VISITS
    match /siteVisits/{visitId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // AGENTS & AGENCIES DIRECTORY (Publicly readable, Admin manageable)
    match /agents/{agentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /agencies/{agencyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // VALUATION REQUESTS
    match /valuations/{valuationId} {
      allow create: if true;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // PROPERTY REPORTS
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // CONTACT & SUPPORT MESSAGES
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
